      given-names: "Diego Fernando"
      orcid: "https://orcid.org/0000-0003-3212-5417"
  title: "Generalism vs. specialization: Does niche breadth influence species responses to anthropogenic land-use change in Neotropical leaf-cutter ants?"
  year: 2026
  doi: "10.64898/2026.08.12.744409"
